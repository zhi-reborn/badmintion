.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #0ABAB5 0%, #0ccec8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.login-card {
  width: 100%;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.1);
}

.logo {
  font-size: 100rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  text-align: center;
  color: #333333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  text-align: center;
  color: #999999;
  margin-bottom: 50rpx;
}

.form-section {
  margin-top: 10rpx;
}

.input-row {
  margin-bottom: 24rpx;
}

.input {
  width: 100%;
  height: 90rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  height: 90rpx;
  background-color: #0ABAB5;
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  border: none;
}

.submit-btn::after {
  border: none;
}