<view class="container">
  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{activities.length === 0}}" class="empty-state">
    <view class="empty-icon">❤️</view>
    <text>暂无收藏的活动</text>
    <view class="empty-tip">在活动详情页点击收藏按钮添加收藏</view>
  </view>

  <view wx:else class="activity-list">
    <view wx:for="{{activities}}" wx:key="_id" class="activity-card">
      <view class="activity-header">
        <view class="activity-type {{item.type === '比赛' ? 'type-match' : item.type === '约球' ? 'type-play' : 'type-train'}}">
          {{item.type || '活动'}}
        </view>
        <view class="activity-status {{item.status === '报名中' ? 'status-open' : item.status === '进行中' ? 'status-ongoing' : 'status-ended'}}">
          {{item.status || '已结束'}}
        </view>
      </view>
      
      <view class="activity-title">{{item.title}}</view>
      
      <view class="activity-info">
        <view class="info-item">
          <text class="info-icon">📍</text>
          <text>{{item.venue || '待定'}}</text>
        </view>
        <view class="info-item">
          <text class="info-icon">🕐</text>
          <text>{{item.time}}</text>
        </view>
      </view>
      
      <view class="activity-footer">
        <view class="participant-info">
          <text class="participant-count">{{item.currentCount || 0}}/{{item.maxCount || '不限'}}</text>
          <text class="participant-label">人已报名</text>
        </view>
        <view class="action-btns">
          <view class="action-btn detail-btn" data-id="{{item._id}}" bindtap="goToActivityDetail">查看详情</view>
          <view class="action-btn unfavorite-btn" data-id="{{item._id}}" bindtap="unfavorite">取消收藏</view>
        </view>
      </view>
    </view>
  </view>
</view>