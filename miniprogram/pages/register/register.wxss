.container {
  padding: 30rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.form-section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.form-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 40rpx;
  text-align: center;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 12rpx;
  display: block;
}

.required {
  color: #ff4d4f;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #f5f5f5;
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999999;
}

.activity-select {
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 16rpx;
}

.activity-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
}

.activity-item checkbox {
  margin-right: 16rpx;
  transform: scale(1.1);
}

.activity-item:last-child {
  margin-bottom: 0;
}

.activity-content {
  flex: 1;
}

.activity-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.activity-desc {
  font-size: 24rpx;
  color: #666666;
}

.empty-tip {
  text-align: center;
  color: #999999;
  padding: 30rpx;
  font-size: 26rpx;
}

.match-items-select {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.match-item-tag {
  padding: 12rpx 24rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666666;
}

.match-item-tag.checked {
  background-color: #e6f7f7;
  color: #0ABAB5;
}

.form-actions {
  margin-top: 30rpx;
  display: flex;
  gap: 20rpx;
}

.btn-cancel {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #ffffff;
  color: #666666;
  border: 2rpx solid #d9d9d9;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn-submit {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #0ABAB5;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.my-registrations {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.registration-list {
  margin-top: 20rpx;
}

.registration-card {
  background-color: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.registration-card:last-child {
  margin-bottom: 0;
}

.reg-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.reg-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.reg-info {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.reg-info text {
  margin-right: 16rpx;
}

.reg-items {
  margin-bottom: 16rpx;
}

.item-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  background-color: #e6f7f7;
  color: #0ABAB5;
  border-radius: 6rpx;
  font-size: 24rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

.card-actions {
  padding-top: 12rpx;
  border-top: 2rpx solid #f0f0f0;
}

.btn-cancel-small {
  width: auto;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 30rpx;
  background-color: #ffffff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
  border-radius: 8rpx;
  font-size: 26rpx;
}
