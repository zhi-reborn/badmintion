.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.tabs {
  display: flex;
  background-color: #ffffff;
  padding: 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666666;
  border-bottom: 4rpx solid transparent;
}

.tab.active {
  color: #0ABAB5;
  border-bottom-color: #0ABAB5;
  font-weight: bold;
}

.loading-state, .empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.match-list {
  padding: 20rpx;
}

.match-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.match-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.match-type {
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background-color: #fff0f0;
  color: #ff4d4f;
}

.match-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.status-open {
  background-color: #e6f7f7;
  color: #0ABAB5;
}

.status-ongoing {
  background-color: #fff7e6;
  color: #fa8c16;
}

.status-ended {
  background-color: #f5f5f5;
  color: #999999;
}

.match-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.match-info {
  margin-bottom: 8rpx;
}

.info-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.info-icon {
  margin-right: 8rpx;
}

.match-record-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.match-record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.match-record-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.match-record-time {
  font-size: 24rpx;
  color: #999999;
}

.match-record-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.player-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.player-info.left {
  align-items: flex-start;
}

.player-info.right {
  align-items: flex-end;
}

.player-name {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 8rpx;
}

.player-score {
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
}

.player-score.winner {
  color: #0ABAB5;
}

.vs {
  font-size: 24rpx;
  color: #999999;
  padding: 0 20rpx;
}

.match-result {
  text-align: center;
  padding: 12rpx 0;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: bold;
  margin-top: 16rpx;
}

.match-result.win {
  background-color: #e6f7f7;
  color: #0ABAB5;
}

.match-result.lose {
  background-color: #fff0f0;
  color: #ff4d4f;
}