<view class="container">
  <view class="tabs">
    <view
      class="tab {{currentTab === 0 ? 'active' : ''}}"
      data-index="0"
      bindtap="onTabChange"
    >
      比赛项目
    </view>
    <view
      class="tab {{currentTab === 1 ? 'active' : ''}}"
      data-index="1"
      bindtap="onTabChange"
    >
      比赛记录
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{currentTab === 0}}">
    <view wx:if="{{matchItems.length === 0}}" class="empty-state">
      <view class="empty-icon">🏸</view>
      <text>暂无报名的比赛项目</text>
    </view>
    <view wx:else class="match-list">
      <view wx:for="{{matchItems}}" wx:key="_id" class="match-card" data-id="{{item._id}}" bindtap="goToMatchDetail">
        <view class="match-header">
          <view class="match-type">比赛项目</view>
          <view class="match-status {{item.status === '报名中' ? 'status-open' : item.status === '进行中' ? 'status-ongoing' : 'status-ended'}}">
            {{item.status || '已结束'}}
          </view>
        </view>
        <view class="match-title">{{item.name}}</view>
        <view class="match-desc" wx:if="{{item.description}}">{{item.description}}</view>
      </view>
    </view>
  </view>

  <view wx:elif="{{currentTab === 1}}">
    <view wx:if="{{matches.length === 0}}" class="empty-state">
      <view class="empty-icon">🏆</view>
      <text>暂无比赛记录</text>
    </view>
    <view wx:else class="match-list">
      <view wx:for="{{matches}}" wx:key="_id" class="match-record-card">
        <view class="match-record-header">
          <text class="match-record-title">{{item.itemName || '比赛'}}</text>
          <text class="match-record-time">{{item.timeDisplay}}</text>
        </view>
        <view class="match-record-body">
          <view class="player-info left">
            <view class="player-name">{{item.team1Display}}</view>
            <view class="player-score {{item.score1 > item.score2 ? 'winner' : ''}}">{{item.score1}}</view>
          </view>
          <view class="vs">VS</view>
          <view class="player-info right">
            <view class="player-score {{item.score2 > item.score1 ? 'winner' : ''}}">{{item.score2}}</view>
            <view class="player-name">{{item.team2Display}}</view>
          </view>
        </view>
        <view wx:if="{{item.isWin || item.isLose}}" class="match-result {{item.isWin ? 'win' : 'lose'}}">
          {{item.isWin ? '胜利' : '失败'}}
        </view>
      </view>
    </view>
  </view>
</view>
