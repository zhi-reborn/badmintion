.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  background: linear-gradient(135deg, #0ABAB5 0%, #0ccec8 100%);
  padding: 40rpx 30rpx;
  color: #ffffff;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.back-btn {
  font-size: 28rpx;
  color: #ffffff;
  padding: 8rpx 16rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  text-align: center;
}

.header-placeholder {
  width: 100rpx;
}

.type-tabs {
  display: flex;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  padding: 8rpx;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 30rpx;
  font-size: 26rpx;
  transition: all 0.3s;
}

.type-tab.active {
  background-color: #ffffff;
  color: #0ABAB5;
  font-weight: bold;
}

.loading-state, .empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.ranking-list {
  padding: 20rpx;
}

.ranking-item {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.ranking-item.top-three {
  background: linear-gradient(135deg, #fffef5 0%, #fff8e1 100%);
}

.rank-number {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #666666;
  margin-right: 20rpx;
}

.medal {
  font-size: 40rpx;
}

.player-info {
  flex: 1;
  display: flex;
  align-items: center;
}

.player-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0ABAB5 0%, #4dd4cf 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 20rpx;
}

.player-detail {
  flex: 1;
}

.player-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.player-stats {
  font-size: 24rpx;
  color: #999999;
}

.player-stats text {
  margin-right: 8rpx;
}

.player-score {
  text-align: right;
}

.score-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #0ABAB5;
}

.score-label {
  font-size: 22rpx;
  color: #999999;
}

.section {
  background-color: #ffffff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
  border-left: 6rpx solid #0ABAB5;
}

.empty-tip {
  text-align: center;
  padding: 30rpx 0;
  color: #999999;
  font-size: 26rpx;
}

.match-list {
  margin-top: 16rpx;
}

.match-card {
  background-color: #fafafa;
  border-radius: 16rpx;
  padding: 0;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.match-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background-color: #f0f0f0;
}

.match-project {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.match-round {
  font-size: 22rpx;
  color: #0ABAB5;
  background-color: #e6f7f7;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.match-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
}

.match-team {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.match-team .team-name {
  font-size: 26rpx;
  color: #333333;
  margin-bottom: 8rpx;
  text-align: center;
}

.match-team .team-score {
  font-size: 40rpx;
  font-weight: bold;
  color: #999999;
}

.match-team.winner .team-name {
  color: #0ABAB5;
  font-weight: bold;
}

.match-team.winner .team-score {
  color: #0ABAB5;
}

.match-vs {
  font-size: 24rpx;
  color: #cccccc;
  padding: 0 20rpx;
  font-weight: bold;
}

.match-footer {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 12rpx 20rpx;
  background-color: #f0f0f0;
}

.match-winner {
  font-size: 24rpx;
  color: #0ABAB5;
  font-weight: 500;
}
