.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 30rpx;
}

.loading-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
}

.header-card {
  background: linear-gradient(135deg, #0ABAB5 0%, #0ccec8 100%);
  padding: 30rpx;
  color: #ffffff;
}

.item-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.status-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.status-label {
  font-size: 26rpx;
  margin-right: 16rpx;
}

.status-picker {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background-color: rgba(255, 255, 255, 0.2);
}

.status-picker .arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
}

.status-registering {
  background-color: rgba(24, 144, 255, 0.3);
}

.status-ongoing {
  background-color: rgba(250, 140, 22, 0.3);
}

.status-finished {
  background-color: rgba(255, 255, 255, 0.2);
}

.stats-row {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.2);
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.8;
}

.section {
  background-color: #ffffff;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.btn-add-small {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  background-color: #0ABAB5;
  color: #ffffff;
  border-radius: 20rpx;
  line-height: 1.4;
}

.empty-tip {
  text-align: center;
  padding: 30rpx 0;
  color: #999999;
  font-size: 26rpx;
}

.player-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.player-tag {
  padding: 8rpx 20rpx;
  background-color: #e6f7f7;
  color: #0ABAB5;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.schedule-list {
  padding-top: 10rpx;
}

.schedule-item {
  background-color: #fafafa;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.schedule-item:last-child {
  margin-bottom: 0;
}

.schedule-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.schedule-round {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
}

.schedule-time {
  font-size: 24rpx;
  color: #999999;
}

.schedule-teams {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.team-text {
  flex: 1;
  font-size: 24rpx;
  color: #666666;
  text-align: center;
}

.vs-text {
  font-size: 22rpx;
  color: #cccccc;
  padding: 0 10rpx;
}

.schedule-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
  border-top: 2rpx solid #f0f0f0;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.status-tag.pending {
  background-color: #f0f0f0;
  color: #999999;
}

.status-tag.playing {
  background-color: #fff7e6;
  color: #fa8c16;
}

.status-tag.finished {
  background-color: #e6f7f7;
  color: #0ABAB5;
}

.btn-delete {
  font-size: 24rpx;
  color: #ff4d4f;
}

.result-list {
  padding-top: 10rpx;
}

.result-item {
  background-color: #fafafa;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.result-item:last-child {
  margin-bottom: 0;
}

.result-round {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.result-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.result-team {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.result-team.winner .team-names {
  color: #0ABAB5;
  font-weight: bold;
}

.result-team.winner .team-score {
  background-color: #0ABAB5;
  color: #ffffff;
}

.team-names {
  font-size: 24rpx;
  color: #666666;
}

.team-score {
  width: 50rpx;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: bold;
  background-color: #f5f5f5;
  color: #999999;
}

.result-vs {
  font-size: 28rpx;
  font-weight: bold;
  color: #cccccc;
  padding: 0 10rpx;
}

.result-actions {
  text-align: right;
  padding-top: 12rpx;
  border-top: 2rpx solid #f0f0f0;
  margin-top: 12rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  width: 85%;
  max-height: 80vh;
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.modal-close {
  font-size: 40rpx;
  color: #999999;
  line-height: 1;
}

.modal-body {
  padding: 30rpx;
  flex: 1;
  overflow-y: auto;
  max-height: 60vh;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #f5f5f5;
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999999;
}

.radio-item {
  display: inline-flex;
  align-items: center;
  margin-right: 40rpx;
  margin-bottom: 20rpx;
}

.radio-item text {
  margin-left: 10rpx;
  font-size: 28rpx;
  color: #333333;
}

.modal-footer {
  display: flex;
  border-top: 2rpx solid #f0f0f0;
}

.btn-cancel, .btn-confirm {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 0;
  font-size: 30rpx;
}

.btn-cancel {
  background-color: #ffffff;
  color: #666666;
  border-right: 2rpx solid #f0f0f0;
}

.btn-confirm {
  background-color: #0ABAB5;
  color: #ffffff;
}
