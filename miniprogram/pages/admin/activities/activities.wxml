<view class="container">
  <view class="header">
    <button class="btn-add" bindtap="showAddModal">+ 发布活动</button>
  </view>

  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{activities.length === 0}}" class="empty-state">
    <view class="empty-icon">📅</view>
    <text>暂无活动</text>
  </view>

  <view wx:else class="activity-list">
    <view wx:for="{{activities}}" wx:key="_id" class="activity-card">
      <view class="activity-header">
        <view class="activity-type {{item.type === '比赛' ? 'type-match' : item.type === '约球' ? 'type-play' : 'type-train'}}">
          {{item.type}}
        </view>
        <view class="activity-status {{item.status === '报名中' ? 'status-open' : item.status === '进行中' ? 'status-ongoing' : 'status-finished'}}">
          {{item.status}}
        </view>
      </view>
      
      <view class="activity-title">{{item.title}}</view>
      
      <view class="activity-info">
        <view class="info-row">
          <text class="info-icon">📍</text>
          <text>{{item.venue || '待定'}}</text>
        </view>
        <view class="info-row">
          <text class="info-icon">🕐</text>
          <text>{{item.time || '待定'}}</text>
        </view>
        <view class="info-row">
          <text class="info-icon">👥</text>
          <text>{{item.currentCount || 0}}/{{item.maxCount}}人</text>
        </view>
        <view class="info-row">
          <text class="info-icon">💰</text>
          <text>¥{{item.fee || 0}}/人</text>
        </view>
      </view>

      <view class="activity-actions">
        <button class="btn-edit" data-id="{{item._id}}" bindtap="editActivity">编辑</button>
        <button class="btn-delete" data-id="{{item._id}}" bindtap="deleteActivity">删除</button>
      </view>
    </view>
  </view>

  <view wx:if="{{showAddModal}}" class="modal-mask" catchtap="closeModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">{{editMode ? '编辑活动' : '发布活动'}}</text>
        <text class="modal-close" bindtap="closeModal">×</text>
      </view>
      
      <scroll-view scroll-y class="modal-body">
        <view class="form-item">
          <view class="form-label">活动标题 <text class="required">*</text></view>
          <input class="form-input" placeholder="请输入活动标题" value="{{formData.title}}" data-field="title" bindinput="onInputChange" />
        </view>

        <view class="form-item">
          <view class="form-label">活动类型</view>
          <picker mode="selector" range="{{typeOptions}}" value="{{typeIndex}}" bindchange="onTypeChange">
            <view class="form-picker">
              <text>{{typeOptions[typeIndex]}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>

        <view class="form-item">
          <view class="form-label">活动状态</view>
          <picker mode="selector" range="{{statusOptions}}" value="{{statusIndex}}" bindchange="onStatusChange">
            <view class="form-picker">
              <text>{{statusOptions[statusIndex]}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>

        <view class="form-item">
          <view class="form-label">活动地点</view>
          <input class="form-input" placeholder="请输入活动地点" value="{{formData.venue}}" data-field="venue" bindinput="onInputChange" />
        </view>

        <view class="form-item">
          <view class="form-label">活动时间</view>
          <input class="form-input" placeholder="如：2024-01-20 14:00" value="{{formData.time}}" data-field="time" bindinput="onInputChange" />
        </view>

        <view class="form-item">
          <view class="form-label">最大人数</view>
          <input class="form-input" type="number" placeholder="20" value="{{formData.maxCount}}" data-field="maxCount" bindinput="onInputChange" />
        </view>

        <view class="form-item">
          <view class="form-label">活动费用（元/人）</view>
          <input class="form-input" type="digit" placeholder="0" value="{{formData.fee}}" data-field="fee" bindinput="onInputChange" />
        </view>

        <view class="form-item">
          <view class="form-label">活动描述</view>
          <textarea class="form-textarea" placeholder="请输入活动描述" value="{{formData.description}}" data-field="description" bindinput="onInputChange" />
        </view>

        <view class="form-item">
          <view class="form-label">分组名称</view>
          <input class="form-input" placeholder="多个组名用逗号分隔，如：A组,B组,C组" value="{{formData.groups}}" data-field="groups" bindinput="onInputChange" />
        </view>
      </scroll-view>

      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeModal">取消</button>
        <button class="btn-confirm" bindtap="saveActivity">确定</button>
      </view>
    </view>
  </view>
</view>
