.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

.tabs {
  display: flex;
  background-color: #ffffff;
  padding: 0 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 30rpx;
  color: #666666;
  position: relative;
}

.tab-item.active {
  color: #0ABAB5;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #0ABAB5;
  border-radius: 3rpx;
}

.swiper {
  flex: 1;
}

.scroll-view {
  height: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

.loading-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.item-list {
  padding-bottom: 20rpx;
}

.item-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.item-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.item-status {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status-registering {
  background-color: #e6f7ff;
  color: #1890ff;
}

.status-ongoing {
  background-color: #fff7e6;
  color: #fa8c16;
}

.status-finished {
  background-color: #f5f5f5;
  color: #999999;
}

.item-info {
  display: flex;
  gap: 30rpx;
  margin-bottom: 12rpx;
}

.info-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666666;
}

.info-icon {
  margin-right: 8rpx;
}

.item-desc {
  font-size: 26rpx;
  color: #999999;
  padding-top: 12rpx;
  border-top: 2rpx solid #f5f5f5;
  line-height: 1.6;
}

.match-list {
  padding-bottom: 20rpx;
}

.match-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.match-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.match-item-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.match-round {
  font-size: 24rpx;
  color: #999999;
}

.match-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.team {
  flex: 1;
  text-align: center;
}

.team-winner .team-name {
  color: #0ABAB5;
  font-weight: bold;
}

.team-winner .team-score {
  background-color: #0ABAB5;
  color: #ffffff;
}

.team-loser .team-name {
  color: #999999;
}

.team-loser .team-score {
  background-color: #f5f5f5;
  color: #999999;
}

.team-name {
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.team-name text {
  display: block;
  margin-bottom: 6rpx;
}

.team-score {
  display: inline-block;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: bold;
}

.vs {
  font-size: 24rpx;
  color: #cccccc;
  padding: 0 20rpx;
}

.match-footer {
  text-align: center;
  padding-top: 16rpx;
  border-top: 2rpx solid #f5f5f5;
}

.match-time {
  font-size: 24rpx;
  color: #999999;
}
