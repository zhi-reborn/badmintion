.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 140rpx;
}

.loading-state,
.empty-state {
  text-align: center;
  padding: 200rpx 0;
  color: #999999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.venue-banner {
  position: relative;
  width: 100%;
  height: 360rpx;
}

.banner-image,
.banner-placeholder {
  width: 100%;
  height: 100%;
}

.banner-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #0ABAB5, #0891a3);
}

.banner-icon {
  font-size: 120rpx;
}

.venue-type-tag {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background-color: rgba(10, 186, 181, 0.9);
  color: #ffffff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.venue-info-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin: -40rpx 20rpx 20rpx;
  padding: 30rpx;
  position: relative;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.venue-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
}

.venue-rating {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 24rpx;
}

.rating-icon {
  margin-right: 4rpx;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #333333;
  border-top: 1rpx solid #f0f0f0;
}

.info-icon {
  margin-right: 16rpx;
}

.info-text {
  flex: 1;
  color: #666666;
}

.info-action {
  font-size: 24rpx;
  color: #0ABAB5;
  padding: 4rpx 16rpx;
  border: 1rpx solid #0ABAB5;
  border-radius: 20rpx;
}

.price-text {
  display: flex;
  align-items: baseline;
}

.price-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.price-unit {
  font-size: 24rpx;
  color: #999999;
  margin-left: 4rpx;
}

.venue-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.facility-tag {
  padding: 6rpx 16rpx;
  background-color: #f0f9f9;
  color: #0ABAB5;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.venue-desc-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.desc-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #ffffff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.bottom-price {
  display: flex;
  align-items: baseline;
}

.book-btn {
  background-color: #0ABAB5;
  color: #ffffff;
  font-size: 30rpx;
  padding: 18rpx 70rpx;
  border-radius: 44rpx;
}
