.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  background-color: #ffffff;
  padding: 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.back-btn {
  font-size: 28rpx;
  color: #0ABAB5;
  padding: 8rpx 16rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.header-placeholder {
  width: 100rpx;
}

.type-tabs {
  display: flex;
  gap: 20rpx;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #666666;
  background-color: #f5f5f5;
}

.type-tab.active {
  background-color: #0ABAB5;
  color: #ffffff;
}

.loading-state, .empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.activity-list {
  padding: 20rpx;
}

.activity-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.activity-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.activity-type {
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.type-match {
  background-color: #fff0f0;
  color: #ff4d4f;
}

.type-play {
  background-color: #f0f9ff;
  color: #1890ff;
}

.type-train {
  background-color: #f0fff4;
  color: #52c41a;
}

.activity-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.status-open {
  background-color: #e6f7f7;
  color: #0ABAB5;
}

.status-ongoing {
  background-color: #fff7e6;
  color: #fa8c16;
}

.activity-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.activity-info {
  margin-bottom: 16rpx;
}

.info-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.info-icon {
  margin-right: 8rpx;
}

.activity-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f0f0;
}

.participant-info {
  display: flex;
  align-items: baseline;
}

.participant-count {
  font-size: 32rpx;
  font-weight: bold;
  color: #0ABAB5;
  margin-right: 8rpx;
}

.participant-label {
  font-size: 24rpx;
  color: #999999;
}

.activity-fee {
  display: flex;
  align-items: baseline;
}

.fee-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.fee-label {
  font-size: 24rpx;
  color: #999999;
}
