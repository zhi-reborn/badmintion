.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  background-color: #ffffff;
  padding: 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-top{
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.back-btn{
  font-size: 28rpx;
  color: #0ABAB5;
  padding: 8rpx 16rpx;
}

.header-title{
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.header-placeholder{
  width: 100rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.type-tabs {
  display: flex;
  gap: 20rpx;
}

.type-tab {
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666666;
  background-color: #f5f5f5;
}

.type-tab.active {
  background-color: #0ABAB5;
  color: #ffffff;
}

.loading-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.venue-list {
  padding: 20rpx;
}

.venue-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.venue-image {
  position: relative;
  width: 100%;
  height: 300rpx;
}

.venue-image image,
.venue-img,
.venue-image-placeholder {
  width: 100%;
  height: 100%;
}

.venue-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #0ABAB5, #0891a3);
}

.venue-image-icon {
  font-size: 80rpx;
}

.venue-type-tag {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background-color: rgba(10, 186, 181, 0.9);
  color: #ffffff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.venue-info {
  padding: 24rpx;
}

.venue-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
}

.venue-address {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.address-icon {
  margin-right: 8rpx;
}

.venue-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.venue-price {
  display: flex;
  align-items: baseline;
}

.price-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.price-unit {
  font-size: 24rpx;
  color: #999999;
  margin-left: 4rpx;
}

.venue-rating {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666666;
}

.rating-icon {
  margin-right: 4rpx;
}

.venue-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.facility-tag {
  padding: 6rpx 16rpx;
  background-color: #f0f9f9;
  color: #0ABAB5;
  border-radius: 6rpx;
  font-size: 22rpx;
}
