.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

.loading-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
}

.header {
  background: linear-gradient(135deg, #0ABAB5 0%, #0ccec8 100%);
  padding: 40rpx 30rpx;
  color: #ffffff;
}

.activity-type {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
  background-color: rgba(255, 255, 255, 0.2);
}

.type-match {
  background-color: rgba(255, 77, 79, 0.3);
}

.type-play {
  background-color: rgba(24, 144, 255, 0.3);
}

.type-train {
  background-color: rgba(82, 196, 26, 0.3);
}

.activity-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.activity-status {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background-color: rgba(255, 255, 255, 0.2);
}

.status-open {
  background-color: rgba(255, 255, 255, 0.3);
}

.status-ongoing {
  background-color: rgba(250, 140, 22, 0.5);
}

.info-card {
  background-color: #ffffff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.info-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.info-content {
  flex: 1;
}

.info-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 6rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
}

.section {
  background-color: #ffffff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
}

.stats-block {
  margin-top: 20rpx;
}

.stats-block:first-of-type {
  margin-top: 0;
}

.stats-subtitle {
  font-size: 26rpx;
  font-weight: bold;
  color: #444444;
  margin-bottom: 14rpx;
}

.stats-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.stats-list.compact {
  flex-direction: row;
  flex-wrap: wrap;
}

.stat-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stat-main {
  width: 180rpx;
  min-width: 0;
}

.stat-name {
  display: block;
  font-size: 26rpx;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-count {
  display: block;
  font-size: 22rpx;
  color: #777777;
  margin-top: 4rpx;
}

.stat-bar {
  flex: 1;
  height: 14rpx;
  border-radius: 8rpx;
  background-color: #edf1f1;
  overflow: hidden;
}

.stat-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  background-color: #0ABAB5;
}

.stat-percent {
  width: 70rpx;
  font-size: 24rpx;
  color: #666666;
  text-align: right;
}

.gender-stat-card {
  min-width: 150rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background-color: #f5fafa;
  border: 2rpx solid #e4f1f0;
}

.gender-stat-name {
  font-size: 24rpx;
  color: #666666;
}

.gender-stat-count {
  font-size: 34rpx;
  font-weight: bold;
  color: #0a8f8b;
  margin-top: 8rpx;
}

.gender-stat-percent {
  font-size: 22rpx;
  color: #888888;
  margin-top: 2rpx;
}

.draw-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.draw-btn {
  margin: 0;
  padding: 0 18rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
  background-color: #0ABAB5;
  color: #ffffff;
  font-size: 26rpx;
}

.draw-result {
  margin-top: 22rpx;
}

.result-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 14rpx;
}

.department-match {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.department-side {
  flex: 1;
  min-width: 0;
  padding: 18rpx;
  border-radius: 12rpx;
  background-color: #f7f9fb;
  border: 2rpx solid #edf1f5;
}

.department-side.muted {
  color: #999999;
  background-color: #fafafa;
}

.department-name {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.department-count {
  display: block;
  font-size: 22rpx;
  color: #777777;
  margin-top: 6rpx;
}

.match-vs {
  width: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background-color: #fff7e6;
  color: #d46b08;
  font-size: 24rpx;
  font-weight: bold;
}

.empty-tip {
  text-align: center;
  padding: 30rpx 0;
  color: #999999;
  font-size: 26rpx;
}

.participant-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.participant-item {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  min-width: 200rpx;
}

.participant-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #0ABAB5;
  color: #ffffff;
  font-size: 26rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 16rpx;
}

.participant-avatar.female {
  background-color: #ff6b81;
}

.participant-info {
  flex: 1;
}

.participant-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 6rpx;
}

.participant-meta {
  font-size: 22rpx;
  color: #666666;
}

.gender-tag {
  display: inline-block;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  margin-right: 8rpx;
  background-color: #e6f7ff;
  color: #1890ff;
}

.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background-color: #ffffff;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.favorite-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  background-color: #f5f5f5;
  font-size: 40rpx;
}

.favorite-btn.favorited {
  background-color: #fff0f0;
}

.btn-register {
  flex: 1;
  background-color: #0ABAB5;
  color: #ffffff;
  text-align: center;
  padding: 24rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.btn-cancel {
  flex: 1;
  background-color: #ffffff;
  color: #ff4d4f;
  text-align: center;
  padding: 24rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: 2rpx solid #ff4d4f;
}

.group-result {
  margin-bottom: 20rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background-color: #f7f9fb;
  border: 2rpx solid #edf1f5;
}

.group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #e8ecef;
}

.group-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #0ABAB5;
}

.group-count {
  font-size: 24rpx;
  color: #777777;
}

.group-participants {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.group-participant {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  background-color: #ffffff;
  border: 1rpx solid #e8ecef;
}

.group-participant .participant-name {
  font-size: 24rpx;
  color: #333333;
  margin-bottom: 0;
}

.group-participant .participant-dept {
  font-size: 20rpx;
  color: #888888;
}

.battle-section {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #e8ecef;
}

.battle-match {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.battle-side {
  flex: 1;
  min-width: 0;
  padding: 18rpx;
  border-radius: 12rpx;
  background-color: #f7f9fb;
  border: 2rpx solid #edf1f5;
}

.battle-side.muted {
  color: #999999;
  background-color: #fafafa;
}

.battle-name {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #0ABAB5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.battle-count {
  display: block;
  font-size: 22rpx;
  color: #777777;
  margin-top: 6rpx;
}

.battle-vs {
  width: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background-color: #fff7e6;
  color: #d46b08;
  font-size: 24rpx;
  font-weight: bold;
}
