<view class="container">
  <view wx:if="{{loading || checkingStatus}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <block wx:else>
    <view class="header">
      <view class="activity-type {{activity.type === '比赛' ? 'type-match' : activity.type === '约球' ? 'type-play' : 'type-train'}}">
        {{activity.type}}
      </view>
      <view class="activity-title">{{activity.title}}</view>
      <view class="activity-status {{activity.status === '报名中' ? 'status-open' : 'status-ongoing'}}">
        {{activity.status}}
      </view>
    </view>

    <view class="info-card">
      <view class="info-item">
        <view class="info-icon">📍</view>
        <view class="info-content">
          <view class="info-label">活动地点</view>
          <view class="info-value">{{activity.venue || '待定'}}</view>
        </view>
      </view>
      <view class="info-item">
        <view class="info-icon">🕐</view>
        <view class="info-content">
          <view class="info-label">活动时间</view>
          <view class="info-value">{{activity.time || '待定'}}</view>
        </view>
      </view>
      <view class="info-item">
        <view class="info-icon">👥</view>
        <view class="info-content">
          <view class="info-label">报名人数</view>
          <view class="info-value">{{participants.length}}/{{activity.maxCount || '不限'}}人</view>
        </view>
      </view>
      <view class="info-item">
        <view class="info-icon">💰</view>
        <view class="info-content">
          <view class="info-label">活动费用</view>
          <view class="info-value">¥{{activity.fee || 0}}/人</view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">活动详情</view>
      <view class="section-content">{{activity.description || '暂无详情'}}</view>
    </view>

    <view class="section" wx:if="{{participants.length > 0}}">
      <view class="section-title">报名统计</view>
      <view class="stats-block">
        <view class="stats-subtitle">部门维度</view>
        <view class="stats-list">
          <view wx:for="{{registrationStats.departmentStats}}" wx:key="name" class="stat-row">
            <view class="stat-main">
              <text class="stat-name">{{item.name}}</text>
              <text class="stat-count">{{item.count}}人</text>
            </view>
            <view class="stat-bar">
              <view class="stat-bar-fill" style="width: {{item.percent}}%;"></view>
            </view>
            <text class="stat-percent">{{item.percent}}%</text>
          </view>
        </view>
      </view>

      <view class="stats-block">
        <view class="stats-subtitle">性别维度</view>
        <view class="stats-list compact">
          <view wx:for="{{registrationStats.genderStats}}" wx:key="name" class="gender-stat-card">
            <view class="gender-stat-name">{{item.name}}</view>
            <view class="gender-stat-count">{{item.count}}人</view>
            <view class="gender-stat-percent">{{item.percent}}%</view>
          </view>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{participants.length > 0}}">
      <view class="section-title">分组抽签</view>
      <view class="draw-actions">
        <button class="draw-btn" bindtap="runGroupDraw">分组抽签</button>
        <button class="draw-btn" bindtap="runGroupBattle">小组对战</button>
      </view>

      <view wx:if="{{groupDraws.length > 0}}" class="draw-result">
        <view class="result-title">分组抽签结果</view>
        <view wx:for="{{groupDraws}}" wx:key="name" class="group-result">
          <view class="group-header">
            <text class="group-name">{{item.name}}</text>
            <text class="group-count">{{item.participants.length}}人</text>
          </view>
          <view class="group-participants">
            <view wx:for="{{item.participants}}" wx:for-item="participant" wx:key="_id" class="group-participant">
              <text class="participant-name">{{participant.name}}</text>
              <text class="participant-dept">{{participant.department}}</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{groupBattles.length > 0}}" class="draw-result">
        <view class="result-title">小组对战表</view>
        <view wx:for="{{groupBattles}}" wx:key="round" class="battle-match">
          <view class="battle-side">
            <text class="battle-name">{{item.groupA.name}}</text>
            <text class="battle-count">{{item.groupA.participantCount}}人</text>
          </view>
          <view class="battle-vs">{{item.status === 'bye' ? '轮空' : 'VS'}}</view>
          <view wx:if="{{item.groupB}}" class="battle-side">
            <text class="battle-name">{{item.groupB.name}}</text>
            <text class="battle-count">{{item.groupB.participantCount}}人</text>
          </view>
          <view wx:else class="battle-side muted">
            <text class="battle-name">等待下一轮</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{participants.length > 0}}">
      <view class="section-title">部门抽签</view>
      <view class="draw-actions">
        <button class="draw-btn" bindtap="runDepartmentDraw">部门抽签</button>
        <button class="draw-btn" bindtap="runDepartmentBattle">部门对战</button>
      </view>

      <view wx:if="{{departmentDraws.length > 0}}" class="draw-result">
        <view class="result-title">部门抽签结果</view>
        <view wx:for="{{departmentDraws}}" wx:key="round" class="department-match">
          <view class="department-side">
            <text class="department-name">{{item.departmentA.name}}</text>
            <text class="department-count">{{item.departmentA.participantCount}}人</text>
          </view>
          <view class="match-vs">{{item.status === 'bye' ? '轮空' : 'VS'}}</view>
          <view wx:if="{{item.departmentB}}" class="department-side">
            <text class="department-name">{{item.departmentB.name}}</text>
            <text class="department-count">{{item.departmentB.participantCount}}人</text>
          </view>
          <view wx:else class="department-side muted">
            <text class="department-name">等待下一轮</text>
          </view>
        </view>
      </view>

      <view wx:if="{{departmentBattles.length > 0}}" class="draw-result">
        <view class="result-title">部门对战表</view>
        <view wx:for="{{departmentBattles}}" wx:key="round" class="battle-match">
          <view class="battle-side">
            <text class="battle-name">{{item.departmentA.name}}</text>
            <text class="battle-count">{{item.departmentA.participantCount}}人</text>
          </view>
          <view class="battle-vs">{{item.status === 'bye' ? '轮空' : 'VS'}}</view>
          <view wx:if="{{item.departmentB}}" class="battle-side">
            <text class="battle-name">{{item.departmentB.name}}</text>
            <text class="battle-count">{{item.departmentB.participantCount}}人</text>
          </view>
          <view wx:else class="battle-side muted">
            <text class="battle-name">等待下一轮</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">已报名 ({{participants.length}}人)</view>
      <view wx:if="{{participants.length === 0}}" class="empty-tip">暂无报名</view>
      <view wx:else class="participant-list">
        <view wx:for="{{participants}}" wx:key="_id" class="participant-item">
          <view class="participant-avatar {{item.gender === '女' ? 'female' : 'male'}}">
            {{item.name ? item.name[0] : '?'}}
          </view>
          <view class="participant-info">
            <view class="participant-name">{{item.name || '匿名用户'}}</view>
            <view class="participant-meta">
              <text class="gender-tag {{item.gender}}">{{item.gender}}</text>
              <text>{{item.department || ''}}</text>
              <text wx:if="{{item.skillLevel}}">· {{item.skillLevel}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="footer-bar">
      <view class="favorite-btn {{isFavorited ? 'favorited' : ''}}" bindtap="toggleFavorite">
        <text>{{isFavorited ? '❤️' : '🤍'}}</text>
      </view>
      <view wx:if="{{isRegistered}}" class="btn-cancel" bindtap="cancelRegistration">取消报名</view>
      <view wx:else class="btn-register" bindtap="registerActivity">立即报名</view>
    </view>
  </block>
</view>
