<view class="container">
  <view class="header">
    <view class="user-info">
      <view class="avatar">{{loginInfo.nickName ? loginInfo.nickName[0] : '?'}}</view>
      <view class="user-detail">
        <view class="user-name">{{loginInfo.nickName || '未登录'}}</view>
        <view class="user-dept">{{loginInfo.phone || '点击登录'}}</view>
      </view>
    </view>
    <view wx:if="{{!loginInfo}}" class="login-btn" bindtap="goToLogin">
      立即登录
    </view>
  </view>

  <view class="stats-card">
    <view class="stat-item">
      <view class="stat-value">{{stats.totalMatches}}</view>
      <view class="stat-label">参赛场次</view>
    </view>
    <view class="stat-item">
      <view class="stat-value">{{stats.wins}}</view>
      <view class="stat-label">胜场</view>
    </view>
    <view class="stat-item">
      <view class="stat-value">{{stats.totalPoints}}</view>
      <view class="stat-label">积分</view>
    </view>
    <view class="stat-item">
      <view class="stat-value">{{stats.ranking || '-'}}</view>
      <view class="stat-label">排名</view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="goToMyMatches">
      <view class="menu-icon">🏸</view>
      <view class="menu-text">我的比赛</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="goToMyActivities">
      <view class="menu-icon">📅</view>
      <view class="menu-text">我的活动</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="goToMyAlbum">
      <view class="menu-icon">📸</view>
      <view class="menu-text">运动相册</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="goToMyFavorites">
      <view class="menu-icon">❤️</view>
      <view class="menu-text">我的收藏</view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <view wx:if="{{loginInfo}}" class="menu-section">
    <view class="menu-item" bindtap="goToRegister">
      <view class="menu-icon">📝</view>
      <view class="menu-text">报名信息</view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <view wx:if="{{loginInfo}}" class="logout-section">
    <view class="logout-btn" bindtap="logout">退出登录</view>
  </view>

  <view wx:if="{{isAdmin}}" class="admin-section">
    <view class="section-title">管理员</view>
    <view class="menu-item" bindtap="goToAdmin">
      <view class="menu-icon">⚙️</view>
      <view class="menu-text">管理后台</view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <view class="footer">
    <text>羽毛球比赛小程序 v1.0.0</text>
  </view>
</view>